{
  "manifest_version": 3,
  "name": "Blu-ray.com Collection Checker",
  "version": "1.4.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Flags movies & TV discs you already own across JB Hi-Fi, Sanity, EzyDVD, Outrun DVD, Orbit DVD, DeadEndDVD, Umbrella, PLAY Music & DVDs, CeX AU, Amazon, and eBay using your Blu-ray.com CSV export.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blu-ray.com Collection Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.jbhifi.com.au/*",
        "https://www.sanity.com.au/*",
        "https://www.ezydvd.com.au/*",
        "https://www.outrundvd.com.au/*",
        "https://outrundvd.com.au/*",
        "https://www.orbitdvd.com/*",
        "https://orbitdvd.com/*",
        "https://deadenddvd.com/*",
        "https://www.deadenddvd.com/*",
        "https://shop.umbrellaent.com.au/*",
        "https://www.umbrellaent.com.au/*",
        "https://umbrellaent.com.au/*",
        "https://www.playmusicdvds.com.au/*",
        "https://playmusicdvds.com.au/*",
        "https://au.webuy.com/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.co.jp/*",
        "https://www.ebay.com.au/*",
        "https://www.ebay.com/*",
        "https://www.ebay.co.uk/*",
        "https://www.ebay.ca/*",
        "https://www.ebay.de/*",
        "https://www.ebay.fr/*",
        "https://www.ebay.it/*",
        "https://www.ebay.es/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}