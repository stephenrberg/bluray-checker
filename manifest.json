{
  "manifest_version": 3,
  "name": "JB, Amazon & eBay AU Blu-ray.com Collection Checker",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Flags JB Hi-Fi, Amazon AU, and eBay AU movies you already own using your Blu-ray.com CSV export.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blu-ray.com Collection Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.jbhifi.com.au/*",
        "https://www.amazon.com.au/*",
        "https://www.ebay.com.au/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}